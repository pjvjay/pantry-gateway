# ContextForge configuration for a local, single-machine gateway in front of the pantry MCP server.
# scripts/install.sh copies this to $CONTEXTFORGE_HOME/.env and fills the secrets; never commit that file.
HOST=127.0.0.1
PORT=4444
DATABASE_URL=sqlite:///CONTEXTFORGE_HOME/mcp.db
AUTH_REQUIRED=true
MCPGATEWAY_UI_ENABLED=true
MCPGATEWAY_ADMIN_API_ENABLED=true
JWT_SECRET_KEY=generated-at-install
AUTH_ENCRYPTION_SECRET=generated-at-install
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=generated-at-install
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=generated-at-install
DEFAULT_USER_PASSWORD=generated-at-install
GATEWAY_TOOL_NAME_SEPARATOR=-
# Local development only: the upstream pantry server runs on this machine. ContextForge's SSRF
# protection blocks loopback upstreams by default (masked 422 on POST /gateways).
SSRF_ALLOW_LOCALHOST=true
