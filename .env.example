# ContextForge configuration for a local, single-machine gateway in front of the pantry MCP server.
# scripts/install.sh copies this to $CONTEXTFORGE_HOME/.env and fills the secrets; never commit that file.
HOST=127.0.0.1
PORT=4444
DATABASE_URL=sqlite:///CONTEXTFORGE_HOME/mcp.db
AUTH_REQUIRED=true
MCPGATEWAY_UI_ENABLED=true
MCPGATEWAY_ADMIN_API_ENABLED=true
JWT_SECRET_KEY=generated-at-install
AUTH_ENCRYPTION_SECRET=generated-at-install
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=generated-at-install
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=generated-at-install
DEFAULT_USER_PASSWORD=generated-at-install
GATEWAY_TOOL_NAME_SEPARATOR=-
# Local development only: the upstream pantry server runs on this machine. ContextForge's SSRF
# protection blocks loopback upstreams by default (masked 422 on POST /gateways).
SSRF_ALLOW_LOCALHOST=true
# The fetch server next to pantry (scripts/fetch_server.py via scripts/run_fetch.sh, then
# scripts/register_fetch.sh). ContextForge itself ignores these keys; run_fetch.sh reads only the
# FETCH_* lines from this file and passes them to the server as arguments.
# The mcp-server-fetch whose tool code the server imports (installed into .venv-fetch).
FETCH_SERVER_VERSION=2026.8.18
FETCH_HOST=127.0.0.1
FETCH_PORT=9100
# robots.txt is honoured unless this is true (passes --ignore-robots-txt). Opt in only for sites you
# are allowed to read that way.
FETCH_IGNORE_ROBOTS_TXT=false
# Loopback, private, link-local and other non-public addresses are refused unless this is true.
FETCH_ALLOW_PRIVATE_ADDRESSES=false
# Empty: the reference's "ModelContextProtocol/1.0 (Autonomous; +https://github.com/modelcontextprotocol/servers)".
# Printable ASCII only (it is an HTTP header).
FETCH_USER_AGENT=
# Seconds per fetch call: robots.txt, download and conversion together. ContextForge gives up at 60.
FETCH_TIMEOUT=30
FETCH_LOG_LEVEL=info
